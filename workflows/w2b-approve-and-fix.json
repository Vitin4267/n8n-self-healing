      "name": "Note-c6c7c3f0"
    },
    {
      "parameters": {
        "content": "ASYNC PATTERN: \"Respond to Webhook\" answers the browser immediately\n(\"processing...\"), but the workflow keeps running after it — Phase 2\ncan take minutes and the browser would time out waiting.",
        "height": 172,
        "width": 380
      },
