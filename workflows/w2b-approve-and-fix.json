    {
      "parameters": {
        "content": "ATOMIC CONSUME: single UPDATE that only succeeds if id+token match,\nstatus is still awaiting_approval, not expired, AND token_used=false —\nsets token_used=true in the same statement. Prevents double-click from\ntriggering Phase 2 twice (DB serializes concurrent writes).",
        "height": 212,
        "width": 444
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
