    {
      "parameters": {
        "command": "=flock -w 300 /var/lock/heal.lock -c '\ncd /home/user/projects/n8n-self-healing && git checkout main && git pull --ff-only && \\\ngit checkout -B fix/incident-{{ $(\"Prepare Fix Incident File\").item.json.incident_id }} && \\\nclaude -p \"$(cat prompts/fix.md)\" \\\n  --allowedTools \"Read,Grep,Glob,Edit,Write,Bash(git:*),Bash(gh pr create:*)\" \\\n  --output-format json --max-turns 40'\n"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1520,
        -320
      ],
      "id": "c8c20c49-ea29-4c59-9f00-aa1e49ed00c2",
      "name": "Execute Command"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.stdout;\nconst lines = raw.trim().split('\\n').reverse();\nconst jsonLine = lines.find(l => l.trim().startsWith('{'));\nconst envelope = JSON.parse(jsonLine);\n\nlet resultText = envelope.result.trim();\nconst fenceMatch = resultText.match(/```json\\s*([\\s\\S]*?)```/i);\nif (fenceMatch) {\n  resultText = fenceMatch[1].trim();\n}\nconst fixResult = JSON.parse(resultText);\n\nreturn [{\n  json: {\n    status: fixResult.status,\n    branch: fixResult.branch,\n    pr_url: fixResult.pr_url,\n    commit: fixResult.commit,\n    abort_reason: fixResult.abort_reason,\n    cost_usd: envelope.total_cost_usd\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1664,
        -320
      ],
      "id": "0fe6589c-2c25-44a5-b14d-e1cc54b6a29b",
      "name": "Parse PR Result"
    },
