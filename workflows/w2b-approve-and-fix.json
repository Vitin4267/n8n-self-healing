    {
      "parameters": {
        "command": "=flock -w 300 /var/lock/heal.lock -c '\ncd /home/victor-ferrareto-dias/projects/n8n-self-healing && git checkout main && git pull --ff-only && \\\ncp .incident/incident-{{ $(\"Prepare Fix Incident File\").item.json.incident_id }}.json .incident/current.json && \\\ngit checkout -B fix/incident-{{ $(\"Prepare Fix Incident File\").item.json.incident_id }} && \\\nclaude -p \"$(cat prompts/fix.md)\" \\\n  --allowedTools \"Read,Grep,Glob,Edit,Write,Bash(git:*),Bash(gh pr create:*)\" \\\n  --output-format json --max-turns 40'\n"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1888,
        -240
      ],
      "id": "c8c20c49-ea29-4c59-9f00-aa1e49ed00c2",
      "name": "Execute Command",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const failed = (why) => [{ json: {\n  status: 'needs_manual_review', branch: null, pr_url: null, commit: null,\n  abort_reason: why, cost_usd: null\n} }];\n\ntry {\n  const raw = String($json.stdout || '');\n  if (!raw.trim()) {\n    return failed('Fix agent produced no output' + ($json.stderr ? ': ' + String($json.stderr).slice(0, 200) : ''));\n  }\n  const lines = raw.trim().split('\\n').reverse();\n  const jsonLine = lines.find(l => l.trim().startsWith('{'));\n  if (!jsonLine) return failed('No JSON envelope in fix agent output');\n  const envelope = JSON.parse(jsonLine);\n\n  let resultText = String(envelope.result || '').trim();\n  const fenceMatch = resultText.match(/```json\\s*([\\s\\S]*?)```/i);\n  if (fenceMatch) {\n    resultText = fenceMatch[1].trim();\n  }\n\n  let fixResult;\n  try {\n    fixResult = JSON.parse(resultText);\n  } catch (e) {\n    // Claude didn't return clean JSON (e.g. a tool call got blocked and it\n    // explained in prose instead) — surface the raw explanation so the human\n    // still gets notified with something actionable.\n    fixResult = { status: 'needs_manual_review', branch: null, pr_url: null, commit: null, abort_reason: resultText };\n  }\n\n  return [{\n    json: {\n      status: fixResult.status,\n      branch: fixResult.branch,\n      pr_url: fixResult.pr_url,\n      commit: fixResult.commit,\n      abort_reason: fixResult.abort_reason,\n      cost_usd: envelope.total_cost_usd\n    }\n  }];\n} catch (e) {\n  return failed('Could not parse fix agent output: ' + String(e.message).slice(0, 200));\n}\n"
      },
