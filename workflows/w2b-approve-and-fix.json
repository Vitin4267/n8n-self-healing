    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH eligible AS (\n  SELECT t.id AS token_id, t.approver_id\n  FROM approval_tokens t\n  JOIN approvers a ON a.id = t.approver_id AND a.active\n  JOIN incidents i ON i.id = t.incident_id\n  WHERE t.incident_id::text = $1\n    AND t.token_hash = encode(sha256(convert_to($2,'UTF8')),'hex')\n    AND t.used_at IS NULL\n    AND t.expires_at > now()\n    AND i.status = 'awaiting_approval'\n    AND i.decided_by IS NULL\n    AND (a.permission_level = 'full' OR (a.permission_level = 'partial' AND i.severity = 'low'))\n  FOR UPDATE OF i, t\n), won AS (\n  UPDATE incidents i\n  SET decided_by = e.approver_id, decided_at = now(), token_used = true, updated_at = now(),\n      status = CASE WHEN $3 = 'approve' THEN i.status ELSE 'rejected' END\n  FROM eligible e\n  WHERE i.id::text = $1 AND i.decided_by IS NULL\n  RETURNING i.id, i.diagnosis_json, i.workflow_id, i.workflow_name, i.node_name, e.approver_id\n), burn AS (\n  UPDATE approval_tokens SET used_at = now()\n  WHERE incident_id::text = $1 AND used_at IS NULL AND EXISTS (SELECT 1 FROM won)\n  RETURNING id\n)\nSELECT w.*, (SELECT count(*) FROM burn) AS tokens_burned FROM won w;",
        "options": {
          "queryReplacement": "={{ [$json.incident, $json.token, $json.kind === 'suggest' ? $json.text : $json.action] }}"
        }
      },
