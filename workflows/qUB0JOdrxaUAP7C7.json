      "name": "Respond to Webhook1"
    },
    {
      "parameters": {
        "jsCode": "const diagnosis = JSON.parse($json.diagnosis_json);\nconst incidentId = $json.id;\nconst token = $('Webhook').item.json.query.token;\n\nconst html = `\n<html>\n<body style=\"font-family: sans-serif; max-width: 600px; margin: 40px auto; padding: 20px;\">\n  <h1>🔍 Incident Review</h1>\n  <p><strong>Workflow:</strong> ${$json.workflow_name}</p>\n  <p><strong>Node:</strong> ${$json.node_name}</p>\n  <p><strong>Error:</strong> ${$json.error_message}</p>\n  <hr>\n  <p><strong>Root cause:</strong> ${diagnosis.root_cause}</p>\n  <p><strong>Proposed fix:</strong> ${diagnosis.proposed_fix || 'None identified'}</p>\n  <p><strong>Risk:</strong> ${diagnosis.risk} | <strong>Confidence:</strong> ${diagnosis.confidence}</p>\n  <div style=\"margin-top: 30px;\">\n    <form method=\"POST\" action=\"http://localhost:5678/webhook/heal-decide\" style=\"display:inline;\">\n      <input type=\"hidden\" name=\"incident\" value=\"${incidentId}\">\n      <input type=\"hidden\" name=\"token\" value=\"${token}\">\n      <input type=\"hidden\" name=\"action\" value=\"approve\">\n      <button type=\"submit\" style=\"background:#22c55e;color:white;padding:10px 20px;border:none;border-radius:6px;font-size:16px;\">✅ Approve</button>\n    </form>\n    <form method=\"POST\" action=\"http://localhost:5678/webhook/heal-decide\" style=\"display:inline; margin-left:10px;\">\n      <input type=\"hidden\" name=\"incident\" value=\"${incidentId}\">\n      <input type=\"hidden\" name=\"token\" value=\"${token}\">\n      <input type=\"hidden\" name=\"action\" value=\"reject\">\n      <button type=\"submit\" style=\"background:#ef4444;color:white;padding:10px 20px;border:none;border-radius:6px;font-size:16px;\">❌ Reject</button>\n    </form>\n  </div>\n</body>\n</html>\n`;\n\nreturn [{ json: { html } }];\n"
      },
