    {
      "parameters": {
        "jsCode": "const wf = $json.workflow;\nconst exec = $json.execution;\n\nconst rawMessage = exec.error?.message || '';\nconst normalizedMessage = rawMessage\n  .replace(/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/g, '<uuid>')\n  .replace(/\\d{4}-\\d{2}-\\d{2}T[\\d:.Z-]+/g, '<timestamp>')\n  .replace(/\\d+/g, '<n>');\n\nconst raw = `${wf.id}|${exec.lastNodeExecuted}|${normalizedMessage}`;\nconst fingerprint = require('crypto').createHash('sha256').update(raw).digest('hex');\n\nreturn [{\n  json: {\n    fingerprint,\n    workflow_id: wf.id,\n    workflow_name: wf.name,\n    node_name: exec.lastNodeExecuted,\n    error_message: rawMessage,\n    execution_url: exec.url,\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        0
      ],
      "id": "415e3443-ab52-429e-b8f6-8f30edb182d6",
      "name": "Code in JavaScript"
    },
    {
