    {
      "parameters": {
        "jsCode": "const raw = $json.stdout;\nconst lines = raw.trim().split('\\n').reverse();\nconst jsonLine = lines.find(l => l.trim().startsWith('{'));\nconst envelope = JSON.parse(jsonLine);\n\nlet resultText = envelope.result.trim();\nconst fenceMatch = resultText.match(/```json\\s*([\\s\\S]*?)```/i);\nif (fenceMatch) {\n  resultText = fenceMatch[1].trim();\n}\nconst diagnosis = JSON.parse(resultText);\n\nreturn [{\n  json: {\n    root_cause: diagnosis.root_cause,\n    evidence: diagnosis.evidence,\n    proposed_fix: diagnosis.proposed_fix,\n    files_to_change: diagnosis.files_to_change,\n    risk: diagnosis.risk,\n    confidence: diagnosis.confidence,\n    needs_human_context: diagnosis.needs_human_context,\n    cost_usd: envelope.total_cost_usd\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
