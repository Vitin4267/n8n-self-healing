        "query": "SELECT id, occurrences FROM incidents\nWHERE fingerprint = $1\n  AND status IN ('triaging', 'awaiting_approval', 'pr_open')\nLIMIT 1;\n",
        "options": {
          "queryReplacement": "={{ [$('Code in JavaScript').item.json.fingerprint] }}\n"
        }
      },
