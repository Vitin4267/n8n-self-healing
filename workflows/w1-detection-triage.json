        "command": "flock -w 300 /var/lock/heal.lock -c '\ncd /home/user/projects/n8n-self-healing && git checkout main && git pull --ff-only && \\\nclaude -p \"$(cat prompts/diagnose.md)\" \\\n  --allowedTools \"Read,Grep,Glob\" \\\n  --output-format json --max-turns 25'\n"
