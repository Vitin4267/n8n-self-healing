    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS incidents (\n  id SERIAL PRIMARY KEY,\n  fingerprint TEXT NOT NULL,\n  workflow_id TEXT NOT NULL,\n  workflow_name TEXT,\n  node_name TEXT,\n  error_type TEXT,\n  error_message TEXT,\n  execution_url TEXT,\n  occurrences INTEGER DEFAULT 1,\n  severity TEXT,\n  status TEXT NOT NULL DEFAULT 'triaging',\n  diagnosis_json TEXT,\n  approval_token TEXT,\n  token_used BOOLEAN DEFAULT false,\n  expires_at TIMESTAMPTZ,\n  pr_url TEXT,\n  created_at TIMESTAMPTZ DEFAULT now(),\n  updated_at TIMESTAMPTZ DEFAULT now()\n);\nCREATE INDEX IF NOT EXISTS idx_fingerprint_status ON incidents (fingerprint, status);\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        544,
        0
      ],
      "id": "c215b74a-77ef-41c3-9f19-31bfac620955",
      "name": "Execute a SQL query",
